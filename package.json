{
  "name": "relevance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:engine": "bun build engine/main.ts --target node --format esm --outfile app/src/generated/engine.mjs --minify-syntax",
    "dev": "bun run build:engine && vite --config app/vite.config.ts",
    "build": "bun run build:engine && vite build --config app/vite.config.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "deploy": "bun run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@sveltejs/vite-plugin-svelte": "5",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.6.11",
    "@types/node-forge": "^1.3.14",
    "playwright-core": "^1.65.1",
    "svelte": "5",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9",
    "vite": "6",
    "wrangler": "4"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-flex": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@material-symbols/svg-400": "^0.49.0",
    "blakejs": "^1.2.1",
    "dompurify": "^3.5.0",
    "fflate": "^0.8.3",
    "marked": "^18.3.0",
    "node-forge": "^1.4.4",
    "qrcode-generator": "^2.0.4",
    "tweetnacl": "^1.0.3"
  }
}

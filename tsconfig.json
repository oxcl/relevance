{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "types": [
      "node",
      "svelte"
    ],
    "paths": {
      "$shared/*": [
        "./shared/*"
      ],
      "$lib/*": [
        "./app/src/lib/*"
      ],
      "$c/*": [
        "./app/src/components/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "app/src/**/*",
    "shared/**/*",
    "engine/**/*"
  ]
}